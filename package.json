{
  "homepage": "./",
  "name": "gene-visualizer",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@visx/curve": "^3.3.0",
    "@visx/group": "^3.3.0",
    "@visx/scale": "^3.5.0",
    "@visx/shape": "^3.3.0",
    "@visx/text": "^3.3.0",
    "@visx/tooltip": "^3.3.0",
    "fflate": "^0.8.3",
    "fuse.js": "^7.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.5.0",
    "react-scripts": "5.0.1",
    "styled-jsx": "^5.1.6",
    "web-vitals": "^2.1.4",
    "zustand": "^4.5.4"
  },
  "scripts": {
    "dev": "craco start",
    "build": "craco build",
    "build-one": "craco build && ./touch-up.py && yarn webpack",
    "verify:bundle": "node scripts/verifyBundle.js",
    "test": "craco test",
    "coverage": "craco test --coverage --watchAll=false",
    "prepare": "husky"
  },
  "jest": {
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1",
      "^.+/createAnalysisWorker$": "<rootDir>/src/store/createAnalysisWorker.testStub.ts"
    },
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/src/store/createAnalysisWorker\\.ts$",
      "/src/store/createAnalysisWorker\\.testStub\\.ts$",
      "/src/store/analysis\\.worker\\.ts$"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@craco/craco": "^7.1.0",
    "@types/wicg-file-system-access": "^2023.10.6",
    "craco-alias": "^3.0.1",
    "css-loader": "^7.1.2",
    "html-bundler-webpack-plugin": "^4.1.2",
    "husky": "^9.1.6",
    "prettier": "3.6.2",
    "ts-loader": "^9.5.1",
    "typescript": "^5.6.3",
    "webpack-cli": "^5.1.4"
  },
  "lint-staged": {
    "src/**/*.{html,ts,css,tsx}": [
      "prettier --config .prettierrc.yaml --write"
    ],
    "src/**/*.{ts,tsx}": [
      "eslint --fix"
    ]
  }
}
